# Configure these as server-side environment variables in Vercel.
# The sender must be a verified email address/domain in Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=website@your-verified-domain.example

# Public analytics identifiers (optional; analytics load only after consent).
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_CLARITY_PROJECT_ID=your_clarity_project_id
VITE_CF_WEB_ANALYTICS_TOKEN=your_cloudflare_beacon_token
