{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/pt/", "permanent": true },
    { "source": "/index.html", "destination": "/pt/", "permanent": true },
    { "source": "/about-us.html", "destination": "/en/about-us.html", "permanent": true },
    { "source": "/services.html", "destination": "/en/services.html", "permanent": true },
    { "source": "/trucks.html", "destination": "/en/trucks.html", "permanent": true },
    { "source": "/vans.html", "destination": "/en/vans.html", "permanent": true },
    { "source": "/minitrucks.html", "destination": "/en/minitrucks.html", "permanent": true },
    { "source": "/fleet.html", "destination": "/en/fleet.html", "permanent": true },
    { "source": "/industries.html", "destination": "/en/industries.html", "permanent": true },
    { "source": "/request-a-quote.html", "destination": "/en/request-a-quote.html", "permanent": true },
    { "source": "/contact.html", "destination": "/en/contact.html", "permanent": true },
    { "source": "/privacy-policy.html", "destination": "/en/privacy-policy.html", "permanent": true },
    { "source": "/cookies.html", "destination": "/en/cookies.html", "permanent": true },
    { "source": "/terms.html", "destination": "/en/terms.html", "permanent": true },
    { "source": "/careers.html", "destination": "/en/careers.html", "permanent": true },
    { "source": "/news.html", "destination": "/en/news.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.clarity.ms https://*.clarity.ms https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://www.googletagmanager.com https://*.google-analytics.com https://*.google.com https://*.clarity.ms https://c.bing.com https://cloudflareinsights.com; font-src 'self' data:; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.google.com https://www.clarity.ms https://*.clarity.ms https://c.bing.com https://cloudflareinsights.com; frame-src https://www.googletagmanager.com https://*.clarity.ms; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'; upgrade-insecure-requests" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
